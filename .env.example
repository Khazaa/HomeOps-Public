# Kopieren nach .env und alle Werte vor dem Start ersetzen.
APP_ORIGIN=https://homeops.example.lan
HOMEOPS_PORT=3000
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
# 32 Zufallsbytes, base64url ohne Padding (z. B. openssl rand -base64 32 anpassen)
MASTER_KEY=CHANGE_ME_43_BASE64URL_CHARACTERS____________
# Mindestens 32 zufällige ASCII-Zeichen, unabhängig vom MASTER_KEY
GUAC_TOKEN_KEY=CHANGE_ME_INDEPENDENT_RANDOM_32_CHARS
ADMIN_USERNAME=admin
# Nur beim allerersten Start setzen, danach aus .env entfernen.
ADMIN_INITIAL_PASSWORD=CHANGE_ME_INITIAL_12_CHARS
TRUST_PROXY=true
COOKIE_SECURE=true

# Nur für den optionalen Compose-Acceptance-Profile und niemals produktiv verwenden.
HOMEOPS_TEST_SSH_PASSWORD=CHANGE_ME_TEST_ONLY
