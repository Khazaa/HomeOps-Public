# Optional: vollständiger, vorzugsweise unveränderlicher Image-Tag.
HOMEOPS_IMAGE=ghcr.io/khazaa/homeops-public:latest

# Direkter LAN-Betrieb: IP des Dockerhosts an beiden Stellen einsetzen.
APP_ORIGIN=http://192.168.1.10:3000
HOMEOPS_PORT=3000
HOMEOPS_BIND_ADDRESS=192.168.1.10

# Ausschließlich URL-sichere Zufallszeichen verwenden.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
# Exakt 32 Zufallsbytes als base64url ohne Padding (43 Zeichen).
MASTER_KEY=CHANGE_ME_43_BASE64URL_CHARACTERS____________
# Mindestens 32 zufällige ASCII-Zeichen; unabhängig vom MASTER_KEY.
GUAC_TOKEN_KEY=CHANGE_ME_INDEPENDENT_RANDOM_32_CHARS

ADMIN_USERNAME=admin
# Nur beim ersten Start setzen, danach leeren und den Container neu erstellen.
ADMIN_INITIAL_PASSWORD=CHANGE_ME_INITIAL_12_CHARS
TRUST_PROXY=false
COOKIE_SECURE=false

# Optional mit HTTPS-Reverse-Proxy stattdessen:
# APP_ORIGIN=https://homeops.example.lan
# HOMEOPS_BIND_ADDRESS=127.0.0.1
# TRUST_PROXY=true
# COOKIE_SECURE=true
