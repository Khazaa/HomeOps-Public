# Zu startendes Container-Image. latest vereinfacht Updates; ein fester v*-Tag ermöglicht reproduzierbare Rollbacks.
HOMEOPS_IMAGE=ghcr.io/khazaa/homeops-public:latest

# Exakte Adresse, die im Browser verwendet wird (Schema, Host und ggf. Port; ohne abschließenden /).
APP_ORIGIN=http://192.168.1.10:3000
# Am Dockerhost veröffentlichter Port für die Weboberfläche.
HOMEOPS_PORT=3000
# Host-IP, an die Docker den Port bindet. Bei einem Reverse Proxy auf einem anderen Host die LAN-IP verwenden.
HOMEOPS_BIND_ADDRESS=192.168.1.10

# Kennwort des internen PostgreSQL-Benutzers; lang, zufällig und nur für diese Installation verwenden.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
# Verschlüsselt gespeicherte Credentials. Exakt 32 Zufallsbytes als base64url ohne Padding (43 Zeichen) und sicher sichern.
MASTER_KEY=CHANGE_ME_43_BASE64URL_CHARACTERS____________
# Signiert kurzlebige SSH-/RDP-Tickets. Mindestens 32 zufällige ASCII-Zeichen, unabhängig vom MASTER_KEY.
GUAC_TOKEN_KEY=CHANGE_ME_INDEPENDENT_RANDOM_32_CHARS

# Benutzername des ersten Administratorkontos.
ADMIN_USERNAME=admin
# Wird nur bei leerer Datenbank zur einmaligen Kontoanlage verwendet; danach leeren und den Web-Container neu erstellen.
ADMIN_INITIAL_PASSWORD=CHANGE_ME_INITIAL_12_CHARS
# true hinter einem Reverse Proxy (auch bei HTTP/NPM), sonst false bei direktem Zugriff auf den Dockerhost.
TRUST_PROXY=false
# true nur wenn APP_ORIGIN HTTPS verwendet; für direkten HTTP-LAN-Betrieb false.
COOKIE_SECURE=false

# Optional mit HTTPS-Reverse-Proxy stattdessen:
# APP_ORIGIN=https://homeops.example.lan
# HOMEOPS_BIND_ADDRESS=127.0.0.1
# TRUST_PROXY=true
# COOKIE_SECURE=true
